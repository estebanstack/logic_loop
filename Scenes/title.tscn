[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/title.gd" id="1_title"]
[ext_resource type="Script" path="res://Scripts/space_floor.gd" id="2_floor"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="SpaceFloor" type="Node2D" parent="."]
script = ExtResource("2_floor")
mode = 1

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="Center/MenuBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.85, 1, 1)
theme_override_font_sizes/font_size = 36
text = "LOGIC LOOP"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/MenuBox"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 16
text = "Simulación · Modelos estocásticos · IA"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/MenuBox"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="BtnPlay" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(280, 46)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "JUGAR"

[node name="BtnHelp" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(280, 46)
layout_mode = 2
text = "CÓMO JUGAR"

[node name="BtnQuit" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(280, 46)
layout_mode = 2
text = "SALIR"

[node name="HelpOverlay" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.06, 0.75)

[node name="HelpPanel" type="PanelContainer" parent="HelpOverlay"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -250.0
offset_right = 300.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="HelpOverlay/HelpPanel"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="HelpOverlay/HelpPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HelpTitle" type="Label" parent="HelpOverlay/HelpPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.85, 1, 1)
theme_override_font_sizes/font_size = 22
text = "CÓMO JUGAR"

[node name="GoalHeader" type="Label" parent="HelpOverlay/HelpPanel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "OBJETIVO"

[node name="GoalText" type="Label" parent="HelpOverlay/HelpPanel/Margin/VBox"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
text = "Programa a Spark para que recoja una herramienta en el dispensador logístico y la use en el componente de reparación, sin que el Bot de Mantenimiento lo atrape."
autowrap_mode = 3

[node name="ControlsHeader" type="Label" parent="HelpOverlay/HelpPanel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "CONTROLES"

[node name="ControlsText" type="Label" parent="HelpOverlay/HelpPanel/Margin/VBox"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
text = "Añade comandos con los botones del panel derecho (MOVER, GIRAR, INTERACTUAR, SONDEAR) y pulsa EJECUTAR. BORRAR TODO reinicia el programa."
autowrap_mode = 3

[node name="ParadigmsHeader" type="Label" parent="HelpOverlay/HelpPanel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "LOS 7 PARADIGMAS"

[node name="ParadigmsText" type="Label" parent="HelpOverlay/HelpPanel/Margin/VBox"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
text = "1. Agentes: el Bot es una máquina de estados finitos con visión.
2. Eventos discretos: la bahía es una cola M/M/1/K.
3. Sistemas dinámicos: la batería es un stock con flujos.
4. Cadenas de Markov: el clima espacial cambia de estado.
5. HMM: telemetría oculta (Viterbi) y diagnóstico de la barrera.
6. Teoría de juegos: Halcón y Paloma, y el juego de cobertura.
7. Búsqueda bayesiana: el Bot estima dónde se escondió Spark."
autowrap_mode = 3

[node name="BtnClose" type="Button" parent="HelpOverlay/HelpPanel/Margin/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
text = "CERRAR"

[connection signal="pressed" from="Center/MenuBox/BtnPlay" to="." method="_on_btn_play_pressed"]
[connection signal="pressed" from="Center/MenuBox/BtnHelp" to="." method="_on_btn_help_pressed"]
[connection signal="pressed" from="Center/MenuBox/BtnQuit" to="." method="_on_btn_quit_pressed"]
[connection signal="pressed" from="HelpOverlay/HelpPanel/Margin/VBox/BtnClose" to="." method="_on_btn_close_pressed"]
