[gd_resource type="Theme" format=3]

; Tema global oscuro (sci-fi). Paleta única:
;   fondo panel #0f1726 · borde cian · texto #dbe7f3 · texto tenue #8ca6c2
;   acento cian #7fd8ff · verde #3ddc84 · ámbar #ffb347 · rojo #ff5c5c · azul #5aa0ff
; Escala tipográfica: 11 (pequeño) · 13 (base) · 16 (valor) · 22 (título modal) · 36 (título)

